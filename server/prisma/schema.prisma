datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// 1. User & Identity
model User {
  id                        String    @id @default(uuid())
  email                     String    @unique
  name                      String
  passwordHash              String
  role                      String    @default("USER") // ADMIN | MODERATOR | COURSE_CREATOR | USER
  status                    String    @default("ACTIVE") // ACTIVE | LOCKED | SUSPENDED | PENDING_APPROVAL
  department                String?
  phone                     String?
  location                  String?
  avatar                    String?
  mustChangePassword        Boolean   @default(false)
  passwordResetRequested    Boolean   @default(false)
  passwordResetRequestedAt  DateTime?
  failedLoginAttempts       Int       @default(0)
  lockUntil                 DateTime?
  otpCode                   String?
  otpExpires                DateTime?
  isFirstLogin              Boolean   @default(true)
  googleId                  String?
  lastActive                DateTime  @default(now())
  requestedRole             String?
  moderatorPermissions     String?   // JSON string of granular module permissions
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  assignments               Assignment[]
  enrollmentRequests        CourseEnrollmentRequest[]
  notifications             Notification[]
  activeSessions            ActiveSession[]
  auditLogs                 AuditLog[]
  submissions               AssessmentSubmission[]
  certificates              Certificate[]
  chatMessagesSent          ChatMessage[]             @relation("SentChatMessages")

  @@index([email])
  @@index([role, status])
}

// 2. Course Module & Platform Expiration
model Module {
  id              String    @id @default(uuid())
  code            String    @unique
  title           String
  description     String?
  department      String
  level           String?   @default("Beginner") // Beginner | Intermediate | Advanced
  duration        String?
  instructorName  String?
  instructorId    String?
  type            String    @default("ACADEMY_COURSE") // WORK_MODULE | ACADEMY_COURSE
  status          String    @default("ACTIVE") // DRAFT | ACTIVE | ARCHIVED | DEPRECATED
  rating          Float     @default(4.8)
  ratingCount     Int       @default(12)
  outcomes        String?   // JSON string of outcomes
  prerequisites   String?   // JSON string of prerequisites
  expiresMonths   Int       @default(12)
  expiresAt       DateTime? // Platform automatic removal date
  createdBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sections        Section[]
  assignments     Assignment[]
  enrollmentRequests CourseEnrollmentRequest[]
  assessments     Assessment[]
  certificates    Certificate[]

  @@index([code])
  @@index([status, type, expiresAt])
}

// 3. Curriculum Sections
model Section {
  id        String   @id @default(uuid())
  moduleId  String
  title     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lessons   Lesson[]

  @@index([moduleId, order])
}

// 4. Multi-Modal Lessons
model Lesson {
  id           String   @id @default(uuid())
  sectionId    String
  title        String
  type         String   @default("VIDEO") // VIDEO | YOUTUBE | TEXT | MARKDOWN | DOCUMENT | QUIZ
  videoUrl     String?
  duration     String?
  documentName String?
  content      String?
  notes        String?
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  section      Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId, order])
}

// 5. Assignments & Real-Time Progress
model Assignment {
  id                    String    @id @default(uuid())
  userId                String
  moduleId              String
  assignedBy            String?
  progress              Int       @default(0) // Integer 0 to 100
  status                String    @default("IN_PROGRESS") // ASSIGNED | IN_PROGRESS | UNDER_REVIEW | COMPLETED | OVERDUE | EXPIRED
  dueDate               DateTime
  extensionRequested    Boolean   @default(false)
  extensionReason       String?
  extensionRequestedAt  DateTime?
  completedLessons      String?   // JSON string of lesson IDs ["l1", "l2"]
  lastActive            String?   // JSON string { sectionIdx: 0, lessonIdx: 1, lessonId: "l1", timestamp: 120 }
  submissionNotes       String?
  completedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  module                Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@index([userId, status])
}

// 6. 3-Stage Course Enrollment Requests
model CourseEnrollmentRequest {
  id                    String    @id @default(uuid())
  studentId             String
  moduleId              String
  creatorId             String?
  status                String    @default("PENDING_CREATOR") // PENDING_CREATOR | FORWARDED_TO_ADMIN | APPROVED | REJECTED
  studentReason         String?
  creatorRecommendation String?
  adminNotes            String?
  assignedDueDate       DateTime?
  reviewedByCreatorAt   DateTime?
  reviewedByAdminAt     DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  student               User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  module                Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([studentId, status])
  @@index([creatorId, status])
  @@index([moduleId, status])
}

// 7. Active User Sessions & Dual-Token Rotation
model ActiveSession {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String    @unique
  ipAddress        String?
  userAgent        String?
  isRevoked        Boolean   @default(false)
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRevoked])
  @@index([expiresAt])
}

// 8. Real-Time System Notifications
model Notification {
  id          String    @id @default(uuid())
  recipientId String?   // Null if broadcast to targetRole
  targetRole  String?   // ADMIN | COURSE_CREATOR | MODERATOR | USER
  title       String
  message     String
  type        String    @default("SYSTEM") // ENROLLMENT_REQUEST | PASSWORD_RESET | EXTENSION_REQUEST | APPROVAL | CERTIFICATE | SYSTEM
  link        String?
  isRead      Boolean   @default(false)
  metadata    String?   // JSON string
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  recipient   User?     @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, isRead])
  @@index([targetRole, isRead])
  @@index([recipientId, createdAt])
  @@index([targetRole, createdAt])
}

// 9. Immutable Security Audit Trail
model AuditLog {
  id          String    @id @default(uuid())
  actorId     String?
  actorEmail  String?
  actorName   String?
  action      String    // USER_LOGIN | USER_LOGOUT | USER_LOCK | USER_SUSPEND | MODULE_CREATED | ENROLLMENT_REQUEST | ENROLLMENT_FORWARD | ENROLLMENT_APPROVE
  resource    String?
  details     String?
  ipAddress   String?
  riskLevel   String    @default("LOW") // LOW | MEDIUM | HIGH
  createdAt   DateTime  @default(now())

  actor       User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([action, riskLevel])
  @@index([actorEmail])
  @@index([createdAt])
}

// 10. Question Banks & Assessments
model Assessment {
  id                 String    @id @default(uuid())
  moduleId           String
  title              String
  description        String?
  passingScore       Int       @default(70) // Passing percentage threshold
  sampleSize         Int       @default(10) // Randomized question count drawn per exam
  durationMinutes    Int       @default(45)
  randomizeQuestions Boolean   @default(true)
  questions          String    // JSON string of Question objects
  status             String    @default("PUBLISHED") // DRAFT | PUBLISHED
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  module             Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  submissions        AssessmentSubmission[]

  @@index([moduleId])
}

model AssessmentSubmission {
  id            String    @id @default(uuid())
  assessmentId  String
  userId        String
  answers       String    // JSON string of selected options
  score         Int       // Calculated percentage 0 to 100
  passed        Boolean   @default(false)
  feedback      String?
  submittedAt   DateTime  @default(now())

  assessment    Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, assessmentId])
}

// 11. Tamper-Proof Cryptographic Certificates
model Certificate {
  id               String    @id @default(uuid())
  certificateCode  String    @unique // Format: ESMMS-CERT-YYYY-XXXXXX (or QLV-YYYY-XXXXX)
  userId           String
  moduleId         String
  studentName      String
  courseTitle      String
  scoreAchieved    Int
  status           String    @default("VERIFIED") // VERIFIED | REVOKED
  verificationHash String    @unique // SHA-256 hash
  issuedAt         DateTime  @default(now())

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  module           Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([certificateCode])
  @@index([userId, moduleId])
}

// 12. Real-Time Enterprise Inbox & Messaging System
model ChatMessage {
  id              String    @id @default(uuid())
  type            String    @default("COMMUNITY") // ANNOUNCEMENT | COMMUNITY | DIRECT
  senderId        String
  senderName      String
  senderEmail     String?
  senderRole      String    // ADMIN | COURSE_CREATOR | MODERATOR | USER
  recipientId     String?   // null for ANNOUNCEMENT & COMMUNITY, target userId for DIRECT
  recipientName   String?
  recipientRole   String?
  content         String
  fileUrl         String?
  fileName        String?
  fileType        String?
  fileSize        Int?
  read            Boolean   @default(false)
  createdAt       DateTime  @default(now())

  sender          User      @relation("SentChatMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([type, createdAt])
  @@index([senderId])
  @@index([recipientId])
}

// 13. Dynamic Course Transfer & SLA Extension Requests
model TransferRequest {
  id                String    @id @default(uuid())
  requestId         String    @unique // e.g. TR-1082
  studentId         String
  studentName       String
  studentEmail      String
  department        String?
  type              String    // COURSE_TRANSFER | SLA_EXTENSION | COHORT_SHIFT
  typeLabel         String
  currentCourseId   String?
  currentCourse     String
  targetCourseId    String?
  targetCourse      String?
  reason            String
  currentDeadline   DateTime?
  requestedDeadline DateTime?
  status            String    @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewedById      String?
  reviewedByName    String?
  reviewedAt        DateTime?
  adminNotes        String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([studentId])
}

