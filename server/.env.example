PORT=5050
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"
BACKUP_DB_URL="postgresql://user:password@host:port/database?sslmode=require"

# JWT Secrets & Expirations
JWT_ACCESS_SECRET="your_jwt_access_secret_key_min_32_bytes"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_key_min_32_bytes"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# SMTP Configuration (For 2FA OTP & Notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_app_password"
SMTP_FROM="your_email@gmail.com"

# Google SSO Client ID
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
