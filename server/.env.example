PORT=5050
NODE_ENV=development
CLIENT_URL=http://localhost:5173
BACKEND_URL=http://localhost:5050

# Custom Domain / CORS Allowances (Comma-separated origins for production)
ADDITIONAL_ALLOWED_ORIGINS="https://app.yourdomain.com,https://admin.yourdomain.com"

# Persistent File Storage (Render Disk Mount / Absolute Volume Path)
# Defaults to ./uploads in development; configure persistent volume path in production
UPLOAD_DIR="./uploads"
STORAGE_PUBLIC_URL=""

# Database Connection (PostgreSQL Primary & Standby Backup)
DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"
BACKUP_DB_URL="postgresql://user:password@host:port/database?sslmode=require"

# JWT Secrets & Expirations (Minimum 32 characters for production security)
JWT_ACCESS_SECRET="your_jwt_access_secret_key_min_32_bytes"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_key_min_32_bytes"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="12h"
JWT_REFRESH_EXPIRES_HOURS=12
JWT_REFRESH_EXPIRES_DAYS="7"

# Administrator Bootstrap (Optional: for npm run admin:bootstrap)
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="YourStrongUniquePassword123!"
ADMIN_NAME="System Administrator"

# Email Configuration
# Option 1 (Recommended for Render Free Tier): Brevo HTTPS REST API (Port 443)
# Get key from app.brevo.com/settings/keys/api (starts with xkeysib-...)
BREVO_API_KEY="xkeysib-your_brevo_api_key"

# Option 2: Brevo SMTP Relay Transport
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=587 # Note: On Render Free Tier, use BREVO_API_KEY or SMTP_PORT=2525
# SMTP_USER: Brevo SMTP login identifier (from app.brevo.com/settings/keys/smtp, e.g. bf6cd9001@smtp-brevo.com)
SMTP_USER="your_brevo_smtp_login@smtp-brevo.com"
# SMTP_PASS: Master SMTP Key generated in Brevo console (starts with xsmtpsib-...)
SMTP_PASS="xsmtpsib-your_brevo_generated_smtp_key"
# SMTP_FROM: An authorized sender address verified in your Brevo account under Senders (app.brevo.com/senders)
SMTP_FROM="EthicaNex <ashwinra26@gmail.com>"

# Google SSO Client ID
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"

# Rate Limiting
GLOBAL_RATE_LIMIT_WINDOW_MS=900000
GLOBAL_RATE_LIMIT_MAX=1500
AUTH_RATE_LIMIT_MAX=60
