PORT=5050
NODE_ENV=development
CLIENT_URL=http://localhost:5173
BACKEND_URL=http://localhost:5050

# Custom Domain / CORS Allowances (Comma-separated origins for production)
ADDITIONAL_ALLOWED_ORIGINS="https://app.yourdomain.com,https://admin.yourdomain.com"

# Persistent File Storage (Render Disk Mount / Absolute Volume Path)
# Defaults to ./uploads in development; configure persistent volume path in production
UPLOAD_DIR="./uploads"
STORAGE_PUBLIC_URL=""

# Database Connection (PostgreSQL Primary & Standby Backup)
DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"
BACKUP_DB_URL="postgresql://user:password@host:port/database?sslmode=require"

# JWT Secrets & Expirations (Minimum 32 characters for production security)
JWT_ACCESS_SECRET="your_jwt_access_secret_key_min_32_bytes"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_key_min_32_bytes"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_DAYS="7"

# Administrator Bootstrap (Optional: for npm run admin:bootstrap)
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="YourStrongUniquePassword123!"
ADMIN_NAME="System Administrator"

# Email Configuration (Option A: Standard SMTP — Gmail, SendGrid, Mailgun)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_app_password"
SMTP_FROM="your_email@gmail.com"

# Email Configuration (Option B: Resend Cloud Service)
RESEND_API_KEY=""
FROM_EMAIL="onboarding@resend.dev"

# Google SSO Client ID
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"

# Rate Limiting
GLOBAL_RATE_LIMIT_WINDOW_MS=900000
GLOBAL_RATE_LIMIT_MAX=1500
AUTH_RATE_LIMIT_MAX=60
